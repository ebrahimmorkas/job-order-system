NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# Mongodb
MONGODB_URI=mongodb://127.0.0.1:27017/job-order

# Frontend
CLIENT_URL=http://localhost:5173

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
IS_REDIS_SERVER_ON=0

# Encryption - generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"   (16 for the IV)
# ID_ENCRYPTION_KEY: 64 hex chars, ID_ENCRYPTION_IV: 32 hex chars, CREDENTIALS_ENCRYPTION_KEY: 64 hex chars
ID_ENCRYPTION_KEY=
ID_ENCRYPTION_IV=
CREDENTIALS_ENCRYPTION_KEY=

# JWT Auth - generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=30d

# Cookie signing
COOKIE_SECRET=

# bcrypt
SALT_ROUNDS=12

# Seeds - the password seeds/seedUser.js gives the owner it creates. Only
# needed while running that seed: set it, run the seed, then remove it again.
# Never commit a real value.
SEED_ADMIN_PASSWORD=

# The vendor domain the seeds work on (default 'localhost'). Can also be given
# as the first argument: node seeds/seedVendor.js localhost1
SEED_VENDOR_DOMAIN=

# Number of reverse proxies in front of the app (1 behind nginx). Leave empty
# when nothing sits in front of it - see server.js. 'true' on stage (Vercel ->
# Render), so the vendor is found from the domain the visitor opened.
TRUST_PROXY=

# Stage only. If a request still arrives on the backend's own address
# (RENDER_EXTERNAL_HOSTNAME, set by Render itself), this vendor domain is used
# instead - see utils/requestDomain.js. Leave empty in local development.
DEFAULT_VENDOR_DOMAIN=

# On Render the server calls its own /healthz every 10 minutes so the free
# plan never puts it to sleep (services/keepAliveService.js). 0 turns that
# off. Has no effect anywhere else.
KEEP_ALIVE_ENABLED=

# ---- Image storage --------------------------------------------------------
# The PLATFORM's own accounts, used when a vendor has no imageService of their
# own (WebsiteMaster.mainImageService) or while enforceMainImageService is on.
# A vendor's own account is saved with scripts/manageVendorStorageCredentials.js.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_URL=
# 'local' provider: folder for uploaded files, relative to backend/ (default uploads)
LOCAL_STORAGE_PATH=

# Seeds - company name / login tagline seedCompanySettings gives a NEW vendor
SEED_COMPANY_NAME=
SEED_LOGIN_TAGLINE=
